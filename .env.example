# -------------- UI FORGE STUDIO — ENVIRONMENT TEMPLATE --------------
# Copy to .env.local and fill in real values. Never commit .env.local.
# Full descriptions: README.md § Environment variables.

# Canonical origin (production: https://uiforgestudio.com.au)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 'production' on the production deploy; anything else enables preview
# behaviour (robots noindex, Contentful preview endpoints).
NEXT_PUBLIC_ENVIRONMENT=development

# Contentful (Insights articles)
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=

# reCAPTCHA (project-inquiry form; optional in dev)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTURE_PRIVATE_API_KEY=

# Contact email override (optional)
NEXT_PUBLIC_CONTACT_EMAIL=

# Mailchimp (newsletter; optional)
NEXT_PUBLIC_MAILCHIMP_SERVER_PREFIX=
NEXT_PUBLIC_MAILCHIMP_LIST_ID=
NEXT_PUBLIC_MAILCHIMP_API_KEY=

# Demo-content mode (server-side only — no NEXT_PUBLIC_ prefix).
# 'true' merges clearly-labelled fictional demo case studies and sample
# testimonials into the site so every layout can be designed and tested.
# Demo pages are always labelled, noindexed and excluded from the sitemap.
# Leave 'false' (or unset) for production. Evaluated at build/static
# generation time — redeploy after changing it.
SHOW_DEMO_CONTENT=false
